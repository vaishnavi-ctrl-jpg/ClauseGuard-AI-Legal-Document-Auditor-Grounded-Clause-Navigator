# ==============================================================================
# ClauseGuard Environment Variables Configuration
# ==============================================================================

# Google Gemini API Key
# Obtain free from Google AI Studio: https://aistudio.google.com/
# NOTE: If this key is not provided, ClauseGuard operates in explicit "Demo Mode",
# displaying an amber disclosure banner and running on its deterministic evaluation engine.
GEMINI_API_KEY=your_gemini_api_key_here

# (Optional) Model override (default: gemini-1.5-flash)
# Options: gemini-1.5-flash, gemini-1.5-pro
GEMINI_MODEL=gemini-1.5-flash

# (Optional) Production Distributed Rate Limiting via Upstash Redis
# If omitted, ClauseGuard uses its built-in in-memory sliding window rate limiter.
# UPSTASH_REDIS_REST_URL=https://your-upstash-instance.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your_upstash_token_here
